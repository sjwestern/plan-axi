{
  "name": "plan-axi",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight plan -> apply -> archive workflow for coding agents: AXI CLIs (docs-axi, change-axi) plus skills",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/docs-axi && npm run build -w packages/change-axi",
    "test": "npm run test --workspaces --if-present",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:uninstall": "node scripts/install-skills.mjs --uninstall",
    "changeset": "changeset",
    "version": "changeset version",
    "changelog": "git-cliff -o CHANGELOG.md",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.0.0",
    "git-cliff": "^2.14.2",
    "husky": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
